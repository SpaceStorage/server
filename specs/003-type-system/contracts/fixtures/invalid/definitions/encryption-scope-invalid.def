# expect: EncryptionScopeInvalid{mode=memory, scope=drives}
# Clarification Q5: a memory-mode container may only declare drives_and_memory.
namespace            = tenant-a
name                 = session_cache
type                 = kv_collection
mode                 = memory
encryption.algorithm = aes-256-gcm
encryption.key       = kv-rambler/data/ss/tenant-a
encryption.scope     = drives

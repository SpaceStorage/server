{
  "project": "spacestorage-server",
  "root": "server/",
  "docs": {
    "constitution": ".specify/memory/constitution.md",
    "intent": ".specify/intent/",
    "specs": "specs/",
    "milestones": "docs/milestones/",
    "agents": "AGENTS.md"
  },
  "nodes": [
    {"id": "constitution", "kind": "truth", "path": ".specify/memory/constitution.md"},
    {"id": "intent", "kind": "truth", "path": ".specify/intent/"},
    {"id": "specs", "kind": "truth", "path": "specs/"},
    {"id": "milestones", "kind": "truth", "path": "docs/milestones/"},
    {"id": "slice-1", "kind": "slice", "specs": ["001"], "first_binary": true},
    {"id": "slice-2", "kind": "slice", "specs": ["003", "013", "014"], "note": "014 master-key subset", "first_binary": true},
    {"id": "slice-3", "kind": "slice", "specs": ["002"], "note": "postgresql FB dialect", "first_binary": true},
    {"id": "slice-4", "kind": "slice", "specs": ["002", "015"], "note": "redis + KV MUST", "first_binary": true},
    {"id": "slice-5", "kind": "slice", "specs": ["011", "012", "004"], "first_binary": true},
    {"id": "slice-6", "kind": "slice", "specs": ["002", "015"], "note": "remaining handlers at 015 MUST", "first_binary": false},
    {"id": "slice-7", "kind": "slice", "specs": ["006", "007", "014"], "first_binary": false},
    {"id": "slice-8", "kind": "slice", "specs": ["005"], "first_binary": false},
    {"id": "slice-9", "kind": "slice", "specs": ["008"], "first_binary": false},
    {"id": "slice-10", "kind": "slice", "specs": ["010", "013"], "first_binary": false},
    {"id": "slice-11", "kind": "slice", "specs": ["009"], "first_binary": false},
    {"id": "016", "kind": "spec", "role": "release-profile / conformance / ledger"},
    {"id": "spacestoraged", "kind": "crate"},
    {"id": "spacestorage", "kind": "crate"},
    {"id": "node", "kind": "crate"},
    {"id": "config", "kind": "crate"},
    {"id": "admin-proto", "kind": "crate"},
    {"id": "types", "kind": "crate"},
    {"id": "wal", "kind": "crate"},
    {"id": "identity", "kind": "crate"},
    {"id": "internode", "kind": "crate"},
    {"id": "placement", "kind": "crate"},
    {"id": "handler-postgresql", "kind": "crate"},
    {"id": "handler-redis", "kind": "crate"},
    {"id": "authz", "kind": "crate"},
    {"id": "release-profile", "kind": "crate"},
    {"id": "conformance", "kind": "crate"},
    {"id": "query", "kind": "crate", "defer": true},
    {"id": "compat", "kind": "crate", "defer": true},
    {"id": "observability", "kind": "crate", "defer": false, "note": "slice 9 milestoned"}
  ],
  "edges": [
    {"from": "slice-1", "to": "slice-2", "kind": "implement-after"},
    {"from": "slice-2", "to": "slice-3", "kind": "implement-after"},
    {"from": "slice-3", "to": "slice-4", "kind": "implement-after"},
    {"from": "slice-4", "to": "slice-5", "kind": "implement-after"},
    {"from": "slice-5", "to": "slice-6", "kind": "defer-after-fb"},
    {"from": "wave-1", "to": "001", "kind": "wave"},
    {"from": "wave-2", "to": "003+013+014", "kind": "wave"},
    {"from": "wave-3", "to": "002+015-fb", "kind": "wave"},
    {"from": "wave-4", "to": "011→012→004", "kind": "wave"},
    {"from": "config", "to": "node", "kind": "depends"},
    {"from": "admin-proto", "to": "node", "kind": "depends"},
    {"from": "types", "to": "wal", "kind": "depends"},
    {"from": "types", "to": "handler-postgresql", "kind": "depends"},
    {"from": "types", "to": "handler-redis", "kind": "depends"},
    {"from": "identity", "to": "internode", "kind": "depends"},
    {"from": "internode", "to": "placement", "kind": "depends"},
    {"from": "node", "to": "spacestoraged", "kind": "depends"},
    {"from": "release-profile", "to": "conformance", "kind": "depends"},
    {"from": "conformance", "to": "milestones", "kind": "gates"},
    {"from": "constitution", "to": "specs", "kind": "supersedes"},
    {"from": "intent", "to": "specs", "kind": "inputs"}
  ],
  "implement_order_first_binary": [
    "001",
    ["003", "013", "014-master-key"],
    ["002", "015-fb"],
    ["011", "012", "004"]
  ],
  "gate_first_binary": "cargo test -p spacestorage-conformance --features first-binary"
}
